# ==============================================================================
# VYBE WEB & PWA — PUBLIC ENVIRONMENT VARIABLES
# Copy to .env (local) or configure in Netlify -> Site Configuration -> Environment Variables
# NEVER put SUPABASE_SERVICE_ROLE_KEY or private server secrets in browser env files.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-jwt-key

# Optional WebRTC STUN/TURN configuration for NAT-restricted peer Voice/Video calls
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
