# VYBE Social Platform - Environment Configuration Template
# Store real credentials in the Secrets panel in AI Studio. Never commit production secrets.

# Backend & Realtime Signaling
VYBE_API_BASE_URL=https://api.vybe.social/v1
VYBE_WEBRTC_SIGNALING_URL=wss://signaling.vybe.social

# Payment Gateway (e.g. Razorpay India)
RAZORPAY_KEY_ID=rzp_test_placeholder

# Phone OTP & SMS Delivery (e.g. MSG91 / Twilio)
SMS_GATEWAY_API_KEY=msg91_placeholder

# Gemini AI (Auto-injected if enabled)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
