# ====================================================================
# VYBE 3.0 Social Platform - Environment Configuration Template
# Store real credentials in the Secrets panel in AI Studio or Render Dashboard.
# Never commit production secrets.
# ====================================================================

# 1. Supabase PostgreSQL & Auth Credentials (Free Tier)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# (Backend Render Server Only - NEVER expose in mobile client or public repo)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# 2. Render Custom Backend Server URL
VYBE_API_BASE_URL=https://vybe-backend.onrender.com/api/v1
PORT=8080
CRON_SECRET_KEY=generate_random_secure_cron_secret_here

# 3. WebRTC Live Calling & Signaling
VYBE_WEBRTC_SIGNALING_URL=wss://signaling.vybe.social
STUN_SERVER_URL=stun:stun.l.google.com:19302

# 4. SMS / OTP Gateway (e.g. MSG91 / Twilio)
SMS_GATEWAY_API_KEY=msg91_placeholder

# 5. Payment Gateway (e.g. Razorpay India)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
